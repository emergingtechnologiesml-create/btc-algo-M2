def apply_slippage(pnl_series: pd.Series, spread_bps=5, trade_count=0):
    slip_per_trade = spread_bps / 1e4
    total_slip     = slip_per_trade * trade_count

    adjusted_pnl = pnl_series - total_slip
    print(f"[SLIPPAGE] trades={trade_count}  total_slippage={total_slip:.6f}")
    return adjusted_pnl
